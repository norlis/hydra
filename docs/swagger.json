    "basePath": "/",
    "paths": {
        "/api/events": {
            "get": {
                "description": "Real-time stream of cluster membership events (node.joined, node.left, node.updated) via Server-Sent Events.",
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "topology"
                ],
                "summary": "SSE Cluster Events",
                "responses": {
                    "200": {
                        "description": "SSE stream of events",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Streaming unsupported",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/nodes": {
            "get": {
                "description": "list of cluster nodes (local + active peers)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "topology"
                ],
                "summary": "Nodes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_norlis_hydra_internal_topology.Node"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/problem.Detail"
                        }
                    }
                }
            }
        },
        "/api/proxies": {
            "get": {
                "description": "list of all proxy addresses in the cluster",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "topology"
                ],
                "summary": "Proxies",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_httpapi_handlers.ProxyInfo"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/problem.Detail"
                        }
                    }
                }
            }
        },
        "/api/proxies/test": {
            "get": {
                "description": "Checks if a proxy address is operational by routing a request through it.\nThe target defaults to https://checkip.amazonaws.com (returns the egress IP).\nNote: requires outbound internet access; will fail in air-gapped networks.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "topology"
                ],
                "summary": "Test a proxy",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Proxy address (host:port, e.g. 192.168.1.10:3128)",
                        "name": "address",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Target URL to fetch through the proxy (default: https://checkip.amazonaws.com/)",
                        "name": "target",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/resolve": {
            "post": {
                "description": "Maps each entity id to the node that owns it on the consistent-hash ring.\nInput is a JSON array of strings; empty and duplicate ids are dropped.\nValues are hashed verbatim (no trim/lowercase) to match live routing.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "topology"
                ],
                "summary": "Resolve entity ids to nodes",
                "parameters": [
                    {
                        "description": "Entity ids to resolve",
                        "name": "ids",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/definitions/internal_httpapi_handlers.resolvedNode"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid body or too many ids",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "Ring not converged",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
